{
  "schema": "A_MOMENTUM_WAVE_CAPTURE_SHADOW_SPEC",
  "schema_version": "2.1",
  "engine_version": "0.2.0",
  "authority": "SHADOW_DISCOVERY_ONLY",
  "objective": "M_PRIMARY_DISCOVERY_WITH_CONSERVATIVE_STRUCTURE_SEMANTIC_RESOLUTION_AND_MECHANISM_ABSTRACTION",
  "source": {
    "provider": "GOOGLE_TRENDS",
    "endpoint_family": "TRENDING_NOW_RSS",
    "default_geo": "US",
    "credentials_used": false
  },
  "query_semantics": {
    "DISCOVERY_QUERY": {
      "purpose": "CAPTURE_RAW_MARKET_WAVE",
      "may_define_momentum_anchor": false
    },
    "BRIDGE_QUERY": {
      "purpose": "TEST_COMMERCIAL_EXPRESSION_PROXIMITY",
      "templates": [
        "{trend} shirt",
        "{trend} sticker"
      ],
      "may_define_momentum_anchor": false,
      "generation_requires": "EXPLICIT_COMMERCIAL_BRIDGE_ELIGIBILITY"
    },
    "ANCHOR_QUERY": {
      "purpose": "STABLE_LONGITUDINAL_MECHANISM_MEASUREMENT",
      "assigned_automatically": false,
      "required_before_production_watchlist_promotion": true
    }
  },
  "promotion_policy": {
    "automatic_watchlist_promotion": false,
    "production_watchlist_mutation_forbidden": true,
    "runtime_latest_mutation_forbidden": true,
    "shadow_candidate_default_state": "SHADOW_UNPROVEN",
    "eligible_state": "ELIGIBLE_FOR_ANCHOR_DESIGN",
    "explicit_anchor_design_required": true,
    "downstream_commercial_refresh_required": true,
    "downstream_property_trademark_safety_recheck_required": true,
    "raw_wave_capture_precedes_commercial_bridge": true,
    "raw_wave_default_commercial_bridge_eligible": false,
    "bridge_queries_empty_until_eligibility_pass": true
  },
  "anti_drift": {
    "raw_trend_is_not_commercial_opportunity": true,
    "bridge_success_is_not_momentum_confirmation": true,
    "support_query_may_not_replace_anchor_series": true,
    "provider_failure_is_not_zero_demand": true,
    "no_new_h24_engine": true,
    "no_new_pte_engine": true,
    "no_amazon_etsy_tiktok_pinterest_collectors_in_initial_rollout": true,
    "raw_wave_may_not_auto_materialize_merch_queries": true,
    "raw_and_merch_proxy_wave_are_independent_evidence_tracks": true,
    "merch_proxy_failure_may_not_fail_raw_wave_capture": true,
    "independent_google_trends_requests_may_not_be_compared_by_absolute_0_100_magnitude": true,
    "coupled_wave_is_not_commercial_eligibility": true,
    "merch_native_wave_is_not_commercial_eligibility": true,
    "cross_seed_duplicate_related_queries_must_not_inflate_merch_wave_count": true,
    "named_entity_or_partial_phrase_overlap_may_not_claim_coupled_wave": true,
    "m_wave_may_enter_discovery_without_r_coupling": true,
    "r_m_coupling_may_not_be_discovery_admission_gate": true,
    "temporal_observation_may_not_delay_initial_m_discovery_intake": true,
    "merch_proxy_is_expression_proxy_not_sticker_demand_authority": true,
    "structural_triage_may_not_claim_semantic_entity_resolution": true,
    "structural_triage_pass_is_not_commercial_eligibility": true,
    "structural_triage_pass_is_not_ip_safety_clearance": true,
    "ambiguous_structure_must_default_to_hold": true,
    "product_configuration_demand_may_not_be_relabelled_expression_demand": true,
    "semantic_metadata_provider_may_not_become_market_signal": true,
    "semantic_resolution_requires_exact_label_or_alias_match": true,
    "no_exact_semantic_match_must_remain_hold": true,
    "semantic_resolution_may_not_claim_ip_or_commercial_clearance": true,
    "semantic_resolution_may_not_auto_generate_mechanism": true,
    "multiple_exact_semantic_matches_require_unique_canonical_evidence_or_remain_ambiguous": true,
    "semantic_provider_throttling_must_be_gap_not_semantic_absence": true,
    "mechanism_decomposition_only_for_explicit_review_allowed_candidates": true,
    "mechanism_hypothesis_may_not_reuse_source_wording_or_iconography": true,
    "mechanism_hypothesis_is_not_commercial_eligibility": true,
    "mechanism_hypothesis_is_not_ip_or_property_clearance": true,
    "mechanism_hypothesis_may_not_generate_product_creative": true,
    "mechanism_hypothesis_may_not_materialize_bridge_anchor_or_watchlist": true,
    "unsupported_review_type_must_hold_not_infer": true,
    "merch_proxy_429_may_not_trigger_seed_retry_storm": true,
    "merch_proxy_partial_success_must_survive_later_seed_gap": true,
    "merch_proxy_provider_gap_may_not_mean_no_rising_queries": true,
    "merch_proxy_seed_family_may_not_expand_to_compensate_for_transport_failure": true,
    "wave_shadow_push_may_not_call_external_market_providers": true,
    "wave_shadow_live_provider_calls_are_schedule_or_manual_only": true,
    "code_validation_must_not_consume_market_provider_request_budget": true,
    "bridge_experiment_may_not_open_without_usable_merch_evidence": true,
    "transport_readiness_is_not_commercial_eligibility": true,
    "throttled_merch_transport_must_block_bridge_experiment_input": true
  },
  "current_transport_risk": {
    "longitudinal_sensor_uses_pytrends": true,
    "pytrends_is_unofficial": true,
    "official_google_trends_api_alpha_not_assumed_available": true,
    "wave_raw_capture_does_not_depend_on_pytrends": true,
    "merch_proxy_shadow_uses_pytrends_experimentally": true,
    "raw_wave_capture_does_not_depend_on_pytrends": true,
    "pytrends_repository_archived_since_2025": true,
    "related_queries_429_is_known_pytrends_failure_mode": true,
    "github_hosted_runner_shared_egress_is_rate_limit_risk_not_proven_cause": true,
    "official_trends_api_public_docs_do_not_currently_replace_related_rising_queries": true
  },
  "dual_wave_shadow": {
    "status": "SHADOW_ONLY_NON_AUTHORITATIVE",
    "tracks": {
      "RAW_MARKET_WAVE": {
        "source": "GOOGLE_TRENDS_TRENDING_NOW_RSS",
        "role": "OPEN_MARKET_SURGE_DISCOVERY",
        "transport": "PUBLIC_RSS_NO_CREDENTIAL"
      },
      "MERCH_PROXY_WAVE": {
        "source": "GOOGLE_TRENDS_RELATED_QUERIES_RISING",
        "role": "MERCH_EXPRESSION_LENS",
        "seeds": [
          "shirt",
          "shirts",
          "t shirt"
        ],
        "seed_policy": "FIXED_SMALL_FAMILY_INITIAL_LEARNING_PHASE",
        "transport": "PYTRENDS_EXPERIMENTAL_SHADOW_ONLY",
        "provider_failure_is_zero_demand": false,
        "cross_seed_score_comparison_forbidden": true,
        "transport_policy": {
          "strategy": "BATCH_PAYLOAD_SHARED_COOKIE_PER_WIDGET_PARTIAL_PRESERVATION",
          "one_batched_seed_payload": true,
          "per_widget_fetch": true,
          "partial_success_preserved": true,
          "immediate_seed_retry_on_429": false,
          "rate_limit_circuit_breaker": true,
          "between_seed_seconds": 6,
          "batch_build_retries": 2,
          "rate_limit_cooldown_seconds": 30,
          "rate_limit_is_sensor_gap_not_zero_demand": true,
          "rate_limit_is_not_no_rising_queries": true
        },
        "acceptance_gate": {
          "states": [
            "RECOVERED_WITH_DATA",
            "PARTIAL_WITH_DATA",
            "THROTTLED",
            "PASS_NO_RISING_DATA",
            "PARTIAL_NO_RISING_DATA",
            "OTHER_SENSOR_GAP"
          ],
          "bridge_experiment_input_ready_states": [
            "RECOVERED_WITH_DATA",
            "PARTIAL_WITH_DATA"
          ],
          "readiness_role": "TRANSPORT_AND_EVIDENCE_AVAILABILITY_ONLY_NOT_COMMERCIAL_ELIGIBILITY",
          "throttled_blocks_bridge_experiment_input": true,
          "no_data_may_not_be_interpreted_as_zero_demand": true
        }
      }
    },
    "coupler": {
      "states": [
        "COUPLED_WAVE",
        "MERCH_NATIVE_WAVE",
        "RAW_ONLY_WAVE",
        "UNRESOLVED"
      ],
      "match_policy": "EXACT_NORMALIZED_CORE_ONLY_PARTIAL_OVERLAP_IS_UNRESOLVED",
      "commercial_eligibility_authority": false,
      "mechanism_decomposition_authority": false,
      "bridge_query_materialization": false,
      "anchor_assignment": false,
      "cross_seed_grouping_policy": "NORMALIZED_QUERY_WITH_MERCH_FORMAT_TOKENS_REMOVED_PRESERVE_SEED_EVIDENCE",
      "raw_merch_observations_remain_preserved": true,
      "exact_coupling_required": true,
      "partial_phrase_overlap_state": "UNRESOLVED"
    },
    "discovery_model": {
      "primary_opportunity_lane": "MERCH_PROXY_WAVE",
      "m_intake_state": "DISCOVERY_INTAKE_READY_UNSCREENED",
      "r_wave_role": "PARALLEL_ATTENTION_CONTEXT",
      "coupling_role": "OPTIONAL_EVIDENCE_ENRICHMENT_NOT_ADMISSION_GATE",
      "r_coupling_required_for_m_intake": false,
      "fixed_wait_before_m_intake_hours": 0,
      "temporal_observation_mode": "PARALLEL_NON_BLOCKING",
      "structural_triage_required_before_mechanism_decomposition": true,
      "automatic_mechanism_decomposition": false,
      "automatic_commercial_eligibility": false,
      "production_authority": false
    },
    "structural_triage": {
      "status": "SHADOW_ONLY_NON_AUTHORITATIVE",
      "policy": "HIGH_CONFIDENCE_STRUCTURE_ONLY_DEFAULT_AMBIGUITY_TO_HOLD",
      "dispositions": [
        "PASS_EXPRESSION_STRUCTURE",
        "HOLD_PRODUCT_CONFIGURATION",
        "HOLD_LOCAL_PURCHASE_INTENT",
        "HOLD_SEMANTIC_REVIEW"
      ],
      "pass_types": [
        "PHRASE_EXPRESSION",
        "CAUSE_AWARENESS_EXPRESSION"
      ],
      "unresolved_type": "UNRESOLVED_THEME_OBJECT_ENTITY_OR_PROPERTY",
      "semantic_entity_resolution": false,
      "named_entity_or_property_clearance": false,
      "commercial_eligibility_authority": false,
      "ip_safety_authority": false,
      "mechanism_generation_authority": false,
      "automatic_mechanism_decomposition": false
    },
    "semantic_resolution": {
      "status": "SHADOW_ONLY_NON_AUTHORITATIVE",
      "provider": "WIKIDATA",
      "provider_role": "METADATA_ONLY_NOT_MARKET_SIGNAL",
      "target_disposition": "HOLD_SEMANTIC_REVIEW",
      "exact_match_required": true,
      "ambiguous_or_missing_exact_match_remains_hold": false,
      "semantic_classes": [
        "NAMED_PERSON_ENTITY",
        "CREATIVE_PROPERTY_OR_WORK",
        "ORGANIZATION_OR_BRAND_ENTITY",
        "EVENT_OR_INCIDENT",
        "CULTURAL_SYMBOL_OR_OBJECT",
        "PRODUCT_OR_PHYSICAL_OBJECT",
        "GENERIC_CONCEPT_OR_THEME",
        "EXACT_ENTITY_UNRESOLVED"
      ],
      "market_signal_authority": false,
      "commercial_eligibility_authority": false,
      "ip_safety_authority": false,
      "mechanism_generation_authority": false,
      "automatic_mechanism_decomposition": false,
      "canonicalization_policy": "UNIQUE_PRIMARY_LABEL_OR_UNIQUE_ENWIKI_SITELINK_AMONG_EXACT_MATCHES",
      "ambiguous_or_missing_canonical_match_remains_hold": true,
      "provider_throttling_is_gap_not_semantic_absence": true
    },
    "mechanism_decomposition": {
      "status": "SHADOW_ONLY_NON_AUTHORITATIVE",
      "authority": "SHADOW_ABSTRACTION_ONLY",
      "input_gate": "EXPLICIT_MECHANISM_REVIEW_ALLOWED_ONLY",
      "execution_mode": "AUTOMATIC_SHADOW_TRANSFORM_ON_EXPLICIT_REVIEW_ALLOWED_INPUTS",
      "supported_structural_types": [
        "PHRASE_EXPRESSION",
        "CAUSE_AWARENESS_EXPRESSION"
      ],
      "supported_semantic_classes": [
        "CULTURAL_SYMBOL_OR_OBJECT",
        "GENERIC_CONCEPT_OR_THEME"
      ],
      "unsupported_review_type": "HOLD_UNSUPPORTED_REVIEW_TYPE",
      "abstraction_level": "MECHANISM_FAMILY_ONLY_NOT_PRODUCT_CREATIVE",
      "source_wording_or_iconography_reuse_allowed": false,
      "commercial_eligibility_authority": false,
      "ip_safety_authority": false,
      "mechanism_production_authority": false,
      "idea_generation_authority": false,
      "bridge_query_authority": false,
      "anchor_assignment_authority": false,
      "watchlist_promotion_authority": false,
      "daily7_selection_authority": false
    },
    "trigger_roles": {
      "schedule": "LIVE_SHADOW_PROVIDER_CAPTURE",
      "workflow_dispatch": "OPERATOR_LIVE_SHADOW_PROVIDER_CAPTURE",
      "push": "VALIDATION_ONLY_NO_EXTERNAL_PROVIDER_CALLS"
    },
    "request_budget_policy": {
      "live_provider_calls_on_push": false,
      "live_provider_calls_on_schedule": true,
      "live_provider_calls_on_workflow_dispatch": true,
      "reason": "PRESERVE_PROVIDER_REQUEST_BUDGET_AND_REDUCE_SELF_INDUCED_THROTTLING"
    }
  }
}
