{
  "schema": "A_MOMENTUM_WAVE_CAPTURE_SHADOW_SPEC",
  "schema_version": "1.4",
  "engine_version": "0.2.0",
  "authority": "SHADOW_DISCOVERY_ONLY",
  "objective": "M_PRIMARY_DUAL_WAVE_GOOGLE_TRENDS_SHADOW_DISCOVERY_WITH_R_CONTEXT_AND_NONBLOCKING_TEMPORAL_OBSERVATION",
  "source": {
    "provider": "GOOGLE_TRENDS",
    "endpoint_family": "TRENDING_NOW_RSS",
    "default_geo": "US",
    "credentials_used": false
  },
  "query_semantics": {
    "DISCOVERY_QUERY": {
      "purpose": "CAPTURE_RAW_MARKET_WAVE",
      "may_define_momentum_anchor": false
    },
    "BRIDGE_QUERY": {
      "purpose": "TEST_COMMERCIAL_EXPRESSION_PROXIMITY",
      "templates": [
        "{trend} shirt",
        "{trend} sticker"
      ],
      "may_define_momentum_anchor": false,
      "generation_requires": "EXPLICIT_COMMERCIAL_BRIDGE_ELIGIBILITY"
    },
    "ANCHOR_QUERY": {
      "purpose": "STABLE_LONGITUDINAL_MECHANISM_MEASUREMENT",
      "assigned_automatically": false,
      "required_before_production_watchlist_promotion": true
    }
  },
  "promotion_policy": {
    "automatic_watchlist_promotion": false,
    "production_watchlist_mutation_forbidden": true,
    "runtime_latest_mutation_forbidden": true,
    "shadow_candidate_default_state": "SHADOW_UNPROVEN",
    "eligible_state": "ELIGIBLE_FOR_ANCHOR_DESIGN",
    "explicit_anchor_design_required": true,
    "downstream_commercial_refresh_required": true,
    "downstream_property_trademark_safety_recheck_required": true,
    "raw_wave_capture_precedes_commercial_bridge": true,
    "raw_wave_default_commercial_bridge_eligible": false,
    "bridge_queries_empty_until_eligibility_pass": true
  },
  "anti_drift": {
    "raw_trend_is_not_commercial_opportunity": true,
    "bridge_success_is_not_momentum_confirmation": true,
    "support_query_may_not_replace_anchor_series": true,
    "provider_failure_is_not_zero_demand": true,
    "no_new_h24_engine": true,
    "no_new_pte_engine": true,
    "no_amazon_etsy_tiktok_pinterest_collectors_in_initial_rollout": true,
    "raw_wave_may_not_auto_materialize_merch_queries": true,
    "raw_and_merch_proxy_wave_are_independent_evidence_tracks": true,
    "merch_proxy_failure_may_not_fail_raw_wave_capture": true,
    "independent_google_trends_requests_may_not_be_compared_by_absolute_0_100_magnitude": true,
    "coupled_wave_is_not_commercial_eligibility": true,
    "merch_native_wave_is_not_commercial_eligibility": true,
    "cross_seed_duplicate_related_queries_must_not_inflate_merch_wave_count": true,
    "named_entity_or_partial_phrase_overlap_may_not_claim_coupled_wave": true,
    "m_wave_may_enter_discovery_without_r_coupling": true,
    "r_m_coupling_may_not_be_discovery_admission_gate": true,
    "temporal_observation_may_not_delay_initial_m_discovery_intake": true,
    "merch_proxy_is_expression_proxy_not_sticker_demand_authority": true
  },
  "current_transport_risk": {
    "longitudinal_sensor_uses_pytrends": true,
    "pytrends_is_unofficial": true,
    "official_google_trends_api_alpha_not_assumed_available": true,
    "wave_raw_capture_does_not_depend_on_pytrends": true,
    "merch_proxy_shadow_uses_pytrends_experimentally": true,
    "raw_wave_capture_does_not_depend_on_pytrends": true
  },
  "dual_wave_shadow": {
    "status": "SHADOW_ONLY_NON_AUTHORITATIVE",
    "tracks": {
      "RAW_MARKET_WAVE": {
        "source": "GOOGLE_TRENDS_TRENDING_NOW_RSS",
        "role": "OPEN_MARKET_SURGE_DISCOVERY",
        "transport": "PUBLIC_RSS_NO_CREDENTIAL"
      },
      "MERCH_PROXY_WAVE": {
        "source": "GOOGLE_TRENDS_RELATED_QUERIES_RISING",
        "role": "MERCH_EXPRESSION_LENS",
        "seeds": [
          "shirt",
          "shirts",
          "t shirt"
        ],
        "seed_policy": "FIXED_SMALL_FAMILY_INITIAL_LEARNING_PHASE",
        "transport": "PYTRENDS_EXPERIMENTAL_SHADOW_ONLY",
        "provider_failure_is_zero_demand": false,
        "cross_seed_score_comparison_forbidden": true
      }
    },
    "coupler": {
      "states": [
        "COUPLED_WAVE",
        "MERCH_NATIVE_WAVE",
        "RAW_ONLY_WAVE",
        "UNRESOLVED"
      ],
      "match_policy": "EXACT_NORMALIZED_CORE_ONLY_PARTIAL_OVERLAP_IS_UNRESOLVED",
      "commercial_eligibility_authority": false,
      "mechanism_decomposition_authority": false,
      "bridge_query_materialization": false,
      "anchor_assignment": false,
      "cross_seed_grouping_policy": "NORMALIZED_QUERY_WITH_MERCH_FORMAT_TOKENS_REMOVED_PRESERVE_SEED_EVIDENCE",
      "raw_merch_observations_remain_preserved": true,
      "exact_coupling_required": true,
      "partial_phrase_overlap_state": "UNRESOLVED"
    },
    "discovery_model": {
      "primary_opportunity_lane": "MERCH_PROXY_WAVE",
      "m_intake_state": "DISCOVERY_INTAKE_READY_UNSCREENED",
      "r_wave_role": "PARALLEL_ATTENTION_CONTEXT",
      "coupling_role": "OPTIONAL_EVIDENCE_ENRICHMENT_NOT_ADMISSION_GATE",
      "r_coupling_required_for_m_intake": false,
      "fixed_wait_before_m_intake_hours": 0,
      "temporal_observation_mode": "PARALLEL_NON_BLOCKING",
      "structural_triage_required_before_mechanism_decomposition": true,
      "automatic_mechanism_decomposition": false,
      "automatic_commercial_eligibility": false,
      "production_authority": false
    }
  }
}
