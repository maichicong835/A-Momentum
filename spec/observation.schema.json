{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A-Momentum Observation",
  "type": "object",
  "required": [
    "observation_id",
    "observed_at",
    "entity_type",
    "entity_key",
    "surface",
    "proxy",
    "points",
    "provenance"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "entity_type": {
      "enum": [
        "QUERY_FAMILY",
        "MECHANISM",
        "MARKET_OBJECT"
      ]
    },
    "entity_key": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "enum": [
        "GOOGLE_TRENDS",
        "PINTEREST_TRENDS",
        "TIKTOK_TRENDS",
        "AMAZON",
        "ETSY",
        "DAILY7_IMMUTABLE_RUNS"
      ]
    },
    "proxy": {
      "type": "string",
      "minLength": 1
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "t",
          "value"
        ],
        "properties": {
          "t": {
            "type": "string",
            "format": "date-time"
          },
          "value": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "unit": {
      "type": "string"
    },
    "native_series": {
      "type": "boolean"
    },
    "supporting_only": {
      "type": "boolean"
    },
    "breakout_proxy": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "cohort_percentile": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "object_age_hours": {
          "type": "number",
          "minimum": 0
        },
        "independent_proliferation_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_ref",
        "machine_observed"
      ],
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "machine_observed": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "candidate_key": {
      "type": "string"
    },
    "linked_mechanism_key": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
