{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanitized Daily7 Commerce Observation Export",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "source_repository",
    "source_commit_sha",
    "run_key",
    "exported_at",
    "observations"
  ],
  "properties": {
    "schema": {
      "const": "DAILY7_COMMERCE_OBSERVATION_EXPORT"
    },
    "schema_version": {
      "const": "1.0"
    },
    "source_repository": {
      "const": "maichicong835/Amazon-Daily7Source"
    },
    "source_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "run_key": {
      "type": "string",
      "minLength": 1
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "observed_at",
          "entity_type",
          "entity_key",
          "surface",
          "proxy",
          "unit",
          "value",
          "direction",
          "machine_observed",
          "source_ref"
        ],
        "properties": {
          "observation_id": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "entity_type": {
            "enum": [
              "MARKET_OBJECT",
              "MECHANISM"
            ]
          },
          "entity_key": {
            "type": "string",
            "minLength": 1
          },
          "linked_mechanism_key": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "enum": [
              "ETSY",
              "AMAZON"
            ]
          },
          "proxy": {
            "enum": [
              "LISTING_FAVORITES",
              "LISTING_REVIEW_COUNT",
              "INDEPENDENT_LISTING_COUNT"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "direction": {
            "const": "HIGHER_IS_STRONGER"
          },
          "machine_observed": {
            "const": true
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "candidate_key": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
